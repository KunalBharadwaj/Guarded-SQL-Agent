# Copy to .env and fill in whichever provider you use. The LLM client picks the
# provider automatically from whichever key is present (Groq preferred), or set
# GUARDED_LLM_PROVIDER to force one.
GROQ_API_KEY=
# CEREBRAS_API_KEY=
# OPENROUTER_API_KEY=
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# Optional overrides (see config.py for defaults)
# GUARDED_LLM_PROVIDER=groq                   # groq | cerebras | openrouter | anthropic | openai
# GUARDED_GROQ_MODEL=llama-3.3-70b-versatile  # or openai/gpt-oss-120b
# GUARDED_CEREBRAS_MODEL=gpt-oss-120b
# GUARDED_OPENROUTER_MODEL=anthropic/claude-sonnet-4.5
# GUARDED_ANTHROPIC_MODEL=claude-opus-5-5
# GUARDED_OPENAI_MODEL=gpt-4o
